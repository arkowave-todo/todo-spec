// LikeC4 model for the todo app.
// Source: docs/system.md. IDs in descriptions refer to that document.
// Each element and relationship is tagged with the release that adds it.
// Updates in a later release do not change the tag. They are noted in the description.

model {

  user = actor 'Todo user' {
    #r1
    description 'A-1. Human actor. Uses the system through a frontend (CAP-1 to CAP-3). Present in all releases.'
  }

  todoApp = system 'Todo App' {
    #r1
    description 'Single-user todo app (section 1.1, section 2.1 Security). One shared list across all frontends (section 1.2). One repo per subsystem (ADR 0006).'

    frontendWeb = subsystem 'frontend-web' {
      #r1
      description 'S-1. User web app frontend to todos. Repo todo-fe-web (section 3.1). Starts with one command (section 2.1, Operability).'

      webFe = component 'web-fe' {
        #r1
        technology 'Astro'
        description 'C-1. Web application (CAP-4, ADR 0001). Lets the user create and view todos (CAP-1, CAP-2). Updated in r3 to delete todos (CAP-3). Flows F-1, F-2, F-3. Error handling: section 4.3.'
      }
    }

    backend = subsystem 'backend' {
      #r1
      description 'S-2. Owns the lifecycle of todos and their storage. Implements I-1 api-todo. Repo todo-api (section 3.1). Starts with one command (section 2.1, Operability).'

      todoApi = component 'todo-api' {
        #r1
        technology 'Fastify'
        description 'C-2. API server (ADR 0002, ADR 0008). Implements I-1 api-todo, a REST API described in OpenAPI (ADR 0004). Owns validation of todo text, ids and list order (section 1.2). Reports health (section 2.1, Operability). Updated in r3 to delete todos (CAP-3). Flows F-1, F-2, F-3. Error handling: section 4.3.'
      }

      todoStore = store 'todo-store' {
        #r1
        technology 'Text file'
        description 'C-3. One text file per todo, no database (ADR 0003). Holds D-1 Todo (section 3.3). Only todo-api reads and writes it. Not updated in r3: todo-api removes files for delete (F-3).'
      }
    }

    frontendIos = subsystem 'frontend-ios' {
      #r2
      description 'S-3. User iOS app frontend to todos. Repo todo-fe-ios (section 3.1). Its one start command builds the app and launches it in the Xcode simulator (section 2.1, Operability).'

      iosFe = component 'ios-fe' {
        #r2
        technology 'SwiftUI'
        description 'C-4. iOS application (CAP-5, ADR 0005). Lets the user create and view todos (CAP-1, CAP-2). Updated in r3 to delete todos (CAP-3). Flows F-1, F-2, F-3. Error handling: section 4.3.'
      }
    }
  }

  // r1: create and view through the web frontend

  user -> todoApp.frontendWeb.webFe 'creates and views todos' {
    #r1
    description 'A-1 uses CAP-1 and CAP-2 through the web frontend (CAP-4). Flows F-1, F-2.'
  }

  todoApp.frontendWeb.webFe -> todoApp.backend.todoApi 'creates and lists todos' {
    #r1
    technology 'REST, OpenAPI'
    description 'I-1 api-todo. Create and view operations. Flows F-1, F-2.'
  }

  todoApp.backend.todoApi -> todoApp.backend.todoStore 'writes and reads todo files' {
    #r1
    technology 'File system'
    description 'D-1 Todo stored as one file per todo (section 3.3). Safety of data: section 2.1.'
  }

  // r2: create and view through the iOS frontend

  user -> todoApp.frontendIos.iosFe 'creates and views todos' {
    #r2
    description 'A-1 uses CAP-1 and CAP-2 through the iOS frontend (CAP-5). Flows F-1, F-2.'
  }

  todoApp.frontendIos.iosFe -> todoApp.backend.todoApi 'creates and lists todos' {
    #r2
    technology 'REST, OpenAPI'
    description 'I-1 api-todo. Same contract as the web frontend. Flows F-1, F-2.'
  }

  // r3: delete through both frontends

  user -> todoApp.frontendWeb.webFe 'deletes todos' {
    #r3
    description 'A-1 uses CAP-3 through the web frontend. Flow F-3.'
  }

  user -> todoApp.frontendIos.iosFe 'deletes todos' {
    #r3
    description 'A-1 uses CAP-3 through the iOS frontend. Flow F-3.'
  }

  todoApp.frontendWeb.webFe -> todoApp.backend.todoApi 'deletes todos by id' {
    #r3
    technology 'REST, OpenAPI'
    description 'I-1 api-todo. Delete operation. Flow F-3.'
  }

  todoApp.frontendIos.iosFe -> todoApp.backend.todoApi 'deletes todos by id' {
    #r3
    technology 'REST, OpenAPI'
    description 'I-1 api-todo. Delete operation. Flow F-3.'
  }

  todoApp.backend.todoApi -> todoApp.backend.todoStore 'removes todo files' {
    #r3
    technology 'File system'
    description 'D-1 Todo file removed on delete. Flow F-3.'
  }

}
