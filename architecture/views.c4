// LikeC4 views for the todo app.
// Source: docs/system.md.
// Release views are cumulative: each shows the system as it stands after that release.
// In the r2 view the elements new in r2 are shown in green.
// r3 adds only relationships, which carry the #r3 tag.

views {

  // System context

  view index {
    title 'System context'
    description 'A-1 Todo user and the Todo App. There are no external systems (section 1.3.2).'

    include *
  }

  // Containers: all releases

  view containers of todoApp {
    title 'Containers: all releases'
    description 'Subsystems S-1, S-2, S-3 and components C-1 to C-4 across r1, r2 and r3.'

    include *
    include todoApp.**
  }

  // Containers: one view per release

  view containers_r1 of todoApp {
    title 'Containers: r1'
    description 'r1 adds C-1 web-fe, C-2 todo-api, C-3 todo-store. Flows F-1, F-2.'

    include user
    include todoApp
    include todoApp.** where tag is #r1
    exclude * -> * where tag is #r2 or tag is #r3
  }

  view containers_r2 of todoApp {
    title 'Containers: r2'
    description 'r2 adds S-3 frontend-ios and C-4 ios-fe. Flows F-1, F-2.'

    include user
    include todoApp
    include todoApp.** where tag is #r1 or tag is #r2
    exclude * -> * where tag is #r3

    style todoApp.frontendIos, todoApp.frontendIos.iosFe {
      color green
    }
  }

  view containers_r3 of todoApp {
    title 'Containers: r3'
    description 'r3 adds no components. It updates C-1, C-2, C-4 for delete (CAP-3). Flow F-3.'

    include user
    include todoApp
    include todoApp.**
  }

  // Dynamic views: one per flow (docs/system.md section 4.2)
  // The web frontend is shown. From r2 the iOS frontend follows the same steps.

  dynamic view flow_f1_create {
    title 'F-1 Create a todo'
    description 'r1. Flow F-1 (section 4.2), CAP-1. Error handling: F-1 error, section 4.3.'

    user -> todoApp.frontendWeb.webFe 'types a text and submits it'
    todoApp.frontendWeb.webFe -> todoApp.backend.todoApi 'sends the text'
    todoApp.backend.todoApi -> todoApp.backend.todoStore 'checks the text, makes an id, writes the file'
    todoApp.frontendWeb.webFe <- todoApp.backend.todoApi 'returns the new todo'
    user <- todoApp.frontendWeb.webFe 'shows the todo in the list'
  }

  dynamic view flow_f2_view {
    title 'F-2 View todos'
    description 'r1. Flow F-2 (section 4.2), CAP-2. Exception: F-2.'

    user -> todoApp.frontendWeb.webFe 'opens the frontend'
    todoApp.frontendWeb.webFe -> todoApp.backend.todoApi 'asks for the list'
    todoApp.backend.todoApi -> todoApp.backend.todoStore 'reads the files'
    todoApp.frontendWeb.webFe <- todoApp.backend.todoApi 'returns the list'
    user <- todoApp.frontendWeb.webFe 'shows the list'
  }

  dynamic view flow_f3_delete {
    title 'F-3 Delete a todo'
    description 'r3. Flow F-3 (section 4.2), CAP-3. Error: F-3. Step 4 runs F-2 from step 2.'

    user -> todoApp.frontendWeb.webFe 'chooses delete on a todo'
    todoApp.frontendWeb.webFe -> todoApp.backend.todoApi 'asks to delete it by id'
    todoApp.backend.todoApi -> todoApp.backend.todoStore 'removes the file'
    todoApp.frontendWeb.webFe <- todoApp.backend.todoApi 'confirms the delete'
    // Step 4: run F-2 (steps 2 to 4) to refresh the list
    todoApp.frontendWeb.webFe -> todoApp.backend.todoApi 'F-2: asks for the list'
    todoApp.backend.todoApi -> todoApp.backend.todoStore 'F-2: reads the files'
    todoApp.frontendWeb.webFe <- todoApp.backend.todoApi 'F-2: returns the list'
    user <- todoApp.frontendWeb.webFe 'F-2: shows the list'
  }

}
